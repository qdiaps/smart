<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<HBox alignment="CENTER_LEFT" prefHeight="0.0" prefWidth="600.0" spacing="10.0" style="-fx-border-color: #d8dee9;" BorderPane.alignment="CENTER"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.qdiaps.ui.controller.TopPanelController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <ComboBox fx:id="portName" prefWidth="150.0" promptText="COM-порт" />
        <ComboBox fx:id="baudRate" prefWidth="180.0" promptText="Швидкість (Baud)" />
        <Button fx:id="connectionButton" mnemonicParsing="false" styleClass="success" text="Підключити" />
        <Button fx:id="checkConnectionButton" disable="true" mnemonicParsing="false" text="Перевірити зв'язок" />
        <Separator orientation="VERTICAL" prefHeight="200.0" />
        <Label fx:id="status" text="Немає зв'язку" />
    </children>
    <opaqueInsets>
        <Insets />
    </opaqueInsets>
</HBox>
