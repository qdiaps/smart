<configuration>
    <!-- Default log pattern for release mode: clean, readable, no thread/logger clutter -->
    <property name="RELEASE_PATTERN" value="%d{HH:mm:ss} %highlight(%-5level) %msg%n" />

    <!-- Detailed pattern for debug mode: includes thread and logger -->
    <property name="DEBUG_PATTERN" value="%d{HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36}) - %msg%n" />

    <property scope="context" name="CONSOLE_PATTERN" value="${RELEASE_PATTERN}" />

    <condition class="ch.qos.logback.core.boolex.PropertyEqualityCondition">
        <key>log.level</key>
        <value>DEBUG</value>
    </condition>
    <if>
        <then>
            <property scope="context" name="CONSOLE_PATTERN" value="${DEBUG_PATTERN}" />
        </then>
    </if>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${user.home}/.smart/logs/smart-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="${log.level:-INFO}">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

    <logger name="com.fazecast.jSerialComm" level="WARN" />
</configuration>
